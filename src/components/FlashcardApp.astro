---
import { QUESTIONS } from '../data/questions';
---

<main class="app" data-questions={JSON.stringify(QUESTIONS)}>
  <header class="app-header">
    <p class="app-brand">Nongkrong Cards</p>
    <p class="app-tagline">Pertanyaan santuy buat ngobrol di cafe</p>
    <div class="progress-pill" aria-live="polite">
      <span id="progress-label">1 / 50</span>
    </div>
  </header>

  <section class="deck-area" aria-label="Deck kartu pertanyaan">
    <div class="card-scene">
      <div class="envelope" aria-hidden="true">
        <div class="envelope-body"></div>
        <div class="envelope-flap"></div>
      </div>

      <article class="card card-back" aria-hidden="true">
        <div class="lace-frame">
          <div class="card-face card-face--back">
            <p class="card-back-text">Geser kartu atau tap tombol di bawah</p>
          </div>
        </div>
      </article>

      <article class="card card-front" id="flashcard" aria-live="polite">
        <div class="lace-frame">
          <div class="card-face">
            <p class="question-label" id="question-label">Pertanyaan #1</p>

            <div class="question-body">
              <p class="question-text" id="question-text">{QUESTIONS[0]}</p>
            </div>

            <svg class="heart-icon" viewBox="0 0 32 28" aria-hidden="true">
              <path
                d="M16 24 C16 24 3 15 3 9 C3 5.5 5.5 3 8.5 3 C11 3 13 4.5 16 8 C19 4.5 21 3 23.5 3 C26.5 3 29 5.5 29 9 C29 15 16 24 16 24 Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              ></path>
            </svg>
          </div>
        </div>
      </article>
    </div>
  </section>

  <nav class="controls" aria-label="Navigasi kartu">
    <button type="button" class="nav-btn nav-btn--prev" id="btn-prev" aria-label="Pertanyaan sebelumnya" disabled>
      <span aria-hidden="true">←</span>
      <span class="nav-btn-label">Sebelumnya</span>
    </button>

    <button type="button" class="nav-btn nav-btn--shuffle" id="btn-shuffle" aria-label="Acak urutan pertanyaan">
      <span aria-hidden="true">🔀</span>
      <span class="nav-btn-label">Acak</span>
    </button>

    <button type="button" class="nav-btn nav-btn--next" id="btn-next" aria-label="Pertanyaan berikutnya">
      <span class="nav-btn-label">Berikutnya</span>
      <span aria-hidden="true">→</span>
    </button>
  </nav>

  <p class="hint">Geser kartu ke kiri/kanan atau pakai tombol navigasi</p>
</main>

<script>
  import {
    createInitialState,
    getProgressLabel,
    canGoNext,
    canGoPrev,
    goNext,
    goPrev,
    shuffleIndices,
    getQuestionAt,
  } from '../lib/flashcard';

  const app = document.querySelector('.app')!;
  const questions: string[] = JSON.parse(app.getAttribute('data-questions') ?? '[]');
  let order = questions.map((_, i) => i);
  let state = createInitialState(questions.length);

  const progressLabel = document.getElementById('progress-label')!;
  const questionLabel = document.getElementById('question-label')!;
  const questionText = document.getElementById('question-text')!;
  const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement;
  const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
  const btnShuffle = document.getElementById('btn-shuffle') as HTMLButtonElement;
  const card = document.getElementById('flashcard')!;

  function render() {
    const questionIndex = order[state.currentIndex];
    const question = getQuestionAt(questions, questionIndex) ?? '';

    progressLabel.textContent = getProgressLabel(state);
    questionLabel.textContent = `Pertanyaan #${state.currentIndex + 1}`;
    questionText.textContent = question;

    btnPrev.disabled = !canGoPrev(state);
    btnNext.disabled = !canGoNext(state);
  }

  function animate(direction: 'next' | 'prev') {
    card.classList.remove('slide-out-left', 'slide-out-right', 'slide-in-left', 'slide-in-right');
    void card.offsetWidth;
    card.classList.add(direction === 'next' ? 'slide-out-left' : 'slide-out-right');

    window.setTimeout(() => {
      render();
      card.classList.remove('slide-out-left', 'slide-out-right');
      card.classList.add(direction === 'next' ? 'slide-in-right' : 'slide-in-left');
      window.setTimeout(() => {
        card.classList.remove('slide-in-left', 'slide-in-right');
      }, 280);
    }, 220);
  }

  btnNext.addEventListener('click', () => {
    if (!canGoNext(state)) return;
    state = goNext(state);
    animate('next');
  });

  btnPrev.addEventListener('click', () => {
    if (!canGoPrev(state)) return;
    state = goPrev(state);
    animate('prev');
  });

  btnShuffle.addEventListener('click', () => {
    order = shuffleIndices(questions.length);
    state = createInitialState(questions.length);
    render();
    card.classList.add('shuffle-pop');
    window.setTimeout(() => card.classList.remove('shuffle-pop'), 400);
  });

  let touchStartX = 0;
  let touchStartY = 0;

  card.addEventListener(
    'touchstart',
    (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    },
    { passive: true },
  );

  card.addEventListener(
    'touchend',
    (e) => {
      const deltaX = e.changedTouches[0].screenX - touchStartX;
      const deltaY = e.changedTouches[0].screenY - touchStartY;

      if (Math.abs(deltaX) < 50 || Math.abs(deltaY) > Math.abs(deltaX)) return;

      if (deltaX < 0 && canGoNext(state)) {
        state = goNext(state);
        animate('next');
      } else if (deltaX > 0 && canGoPrev(state)) {
        state = goPrev(state);
        animate('prev');
      }
    },
    { passive: true },
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' && canGoNext(state)) {
      state = goNext(state);
      animate('next');
    } else if (e.key === 'ArrowLeft' && canGoPrev(state)) {
      state = goPrev(state);
      animate('prev');
    }
  });

  render();
</script>

<style>
  .app {
    --maroon: #800020;
    --maroon-dark: #5c0018;
    --cream: #fdf5e6;
    --parchment: #e8dcc8;

    min-height: 100dvh;
    max-width: 520px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .app-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: center;
  }

  .app-brand {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--maroon);
    font-style: italic;
  }

  .app-tagline {
    font-size: 1rem;
    color: #6b5344;
  }

  .progress-pill {
    margin-top: 0.5rem;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(128, 0, 32, 0.12);
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--maroon);
    box-shadow: 0 2px 10px rgba(92, 0, 24, 0.08);
  }

  .deck-area {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 0 1.25rem;
    touch-action: pan-y;
  }

  .card-scene {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 3.1;
  }

  .envelope {
    position: absolute;
    inset: 8% 4% 0;
    z-index: 0;
  }

  .envelope-body {
    position: absolute;
    inset: 18% 0 0;
    background: linear-gradient(180deg, var(--maroon) 0%, var(--maroon-dark) 100%);
    border-radius: 4px 4px 8px 8px;
    box-shadow: 0 10px 24px rgba(92, 0, 24, 0.28);
  }

  .envelope-flap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 52%;
    background: linear-gradient(180deg, #9a0028 0%, var(--maroon) 100%);
    clip-path: polygon(0 0, 50% 72%, 100% 0);
    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.18));
  }

  .card {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 10%;
    bottom: 4%;
    z-index: 2;
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.16));
  }

  .card-back {
    transform: rotate(2.5deg) translate(10px, 8px);
    z-index: 1;
    opacity: 0.92;
  }

  .card-front {
    z-index: 3;
    transition: transform 0.28s ease, opacity 0.28s ease;
  }

  .lace-frame {
    width: 100%;
    height: 100%;
    padding: 18px;
    background: #ffffff;
    position: relative;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.9),
      0 0 0 2px rgba(128, 0, 32, 0.05);
  }

  .lace-frame::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 2px dotted rgba(255, 255, 255, 0.95);
    border-radius: 1px;
    pointer-events: none;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.95) 1.5px, transparent 2px) 0 0 / 14px 14px,
      radial-gradient(circle, rgba(255, 255, 255, 0.85) 1px, transparent 1.5px) 7px 7px / 14px 14px;
    opacity: 0.85;
  }

  .card-face {
    width: 100%;
    height: 100%;
    background: var(--cream);
    position: relative;
    padding: 1.35rem 1.5rem 1.5rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    box-shadow: inset 0 0 40px rgba(128, 0, 32, 0.04);
  }

  .card-face--back {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-back-text {
    font-size: 1rem;
    font-style: italic;
    color: var(--maroon);
    opacity: 0.65;
    text-align: center;
    line-height: 1.45;
  }

  .question-label {
    justify-self: end;
    font-size: 0.95rem;
    font-weight: 600;
    font-style: italic;
    color: var(--maroon);
    text-align: right;
  }

  .question-body {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0.5rem 0;
  }

  .question-text {
    max-width: 92%;
    font-size: clamp(1.15rem, 4.8vw, 1.45rem);
    font-weight: 600;
    font-style: italic;
    line-height: 1.45;
    color: var(--maroon);
    text-align: right;
  }

  .heart-icon {
    width: 28px;
    height: 24px;
    color: var(--maroon);
    align-self: end;
    opacity: 0.9;
  }

  .controls {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.75rem;
    align-items: center;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
    transition: transform 0.15s ease, opacity 0.15s ease, background 0.15s ease;
  }

  .nav-btn:active:not(:disabled) {
    transform: scale(0.96);
  }

  .nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .nav-btn--prev,
  .nav-btn--next {
    background: #fffaf2;
    color: var(--maroon);
    border: 1px solid rgba(128, 0, 32, 0.15);
    box-shadow: 0 4px 14px rgba(92, 0, 24, 0.08);
  }

  .nav-btn--prev {
    justify-self: start;
  }

  .nav-btn--next {
    justify-self: end;
  }

  .nav-btn--shuffle {
    background: var(--maroon);
    color: #fffaf2;
    min-width: 4.5rem;
    min-height: 4.5rem;
    border-radius: 50%;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.85rem;
    box-shadow: 0 6px 18px rgba(128, 0, 32, 0.32);
  }

  .nav-btn-label {
    font-size: 0.85rem;
  }

  .nav-btn--shuffle .nav-btn-label {
    font-size: 0.7rem;
  }

  .hint {
    text-align: center;
    font-size: 0.9rem;
    color: #7a6555;
  }

  .slide-out-left {
    transform: translateX(-115%) rotate(-3deg);
    opacity: 0;
  }

  .slide-out-right {
    transform: translateX(115%) rotate(3deg);
    opacity: 0;
  }

  .slide-in-right {
    animation: slideInRight 0.28s ease forwards;
  }

  .slide-in-left {
    animation: slideInLeft 0.28s ease forwards;
  }

  .shuffle-pop {
    animation: shufflePop 0.4s ease;
  }

  @keyframes slideInRight {
    from {
      transform: translateX(70px) rotate(2deg);
      opacity: 0;
    }
    to {
      transform: translateX(0) rotate(0);
      opacity: 1;
    }
  }

  @keyframes slideInLeft {
    from {
      transform: translateX(-70px) rotate(-2deg);
      opacity: 0;
    }
    to {
      transform: translateX(0) rotate(0);
      opacity: 1;
    }
  }

  @keyframes shufflePop {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @media (min-width: 480px) {
    .app {
      padding-top: 2rem;
    }

    .card-scene {
      max-width: 420px;
    }

    .lace-frame {
      padding: 16px;
    }

    .nav-btn {
      min-height: 3.5rem;
      padding: 0.85rem 1.25rem;
    }
  }
</style>
